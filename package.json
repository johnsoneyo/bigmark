{
  "name": "bigmark-website",
  "private": true,
  "version": "0.1.1",
  "description": "Website of BIG-MARK IT Consult (React, Vite and Tailwind CSS).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/static-routes.mjs",
    "preview": "vite preview --host=0.0.0.0",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.3.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^7.3.5"
  }
}
