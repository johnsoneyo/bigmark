---
import Methodology from "./components/Methodology.astro";
import Toolstack from "./components/Toolstack.astro";
import MaterialIcon from "./components/MaterialIcon.astro";
import { localePath, web3formsAccessKey } from "./config/site";

const {
  brand,
  navLinks,
  contact,
  socialLinks,
  hero,
  sections,
  services,
  projects,
  team,
  footer,
  alternateLocale,
  alternateLabel,
  ui,
} = Astro.props.data;
---

<div
  class="min-h-screen overflow-x-hidden relative bg-[#0D1117]"
>
  <a href="#main-content" class="skip-link">{ui.skipLink}</a>

  <header
    class="fixed top-0 left-0 right-0 z-50 bg-[#0D1117] border-b border-gray-800"
  >
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <a
        href="/"
        class="site-logo flex items-center gap-2 text-[#5B8DFF] font-sans"
        aria-label={`${brand.name} – ${ui.homeLabel}`}
      >
        {
          brand.logoImage ? (
            <img
              src={brand.logoImage}
              alt={brand.name}
              class="h-8 w-auto object-contain"
            />
          ) : (
            <span class="font-bold tracking-tight">{brand.logoText}</span>
          )
        }
      </a>
      <nav
        aria-label={ui.primaryNav}
        class="hidden md:flex gap-8 font-sans text-sm"
      >
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="text-gray-300 hover:text-white transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="hidden md:flex items-center gap-4">
        <a
          href={localePath(alternateLocale)}
          class="text-sm text-gray-300 hover:text-white transition-colors"
          aria-label={ui.switchLanguage}
          hreflang={alternateLocale}
          lang={alternateLocale}
        >
          {alternateLabel}
        </a>
        <a
          href={hero.primaryCta.href}
          class="px-4 py-2 bg-[#0B5CFF] text-white text-sm font-medium hover:bg-[#0B5CFF]/90 transition-colors"
        >
          {hero.primaryCta.label}
        </a>
      </div>
      <div class="md:hidden">
        <button
          type="button"
          aria-label={ui.openMenu}
          data-label-open={ui.openMenu}
          data-label-close={ui.closeMenu}
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-mobile-menu-button
          class="flex h-10 w-10 items-center justify-center border border-gray-800 text-[#5B8DFF] transition-colors hover:border-[#0B5CFF]/50 hover:bg-[#0B5CFF]/10"
        >
          <svg
            data-menu-open
            class="h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          >
          <svg
            data-menu-close
            class="hidden h-6 w-6"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg
          >
        </button>
      </div>
    </div>
  </header>

  <nav
    id="mobile-menu"
    aria-label={ui.mobileNav}
    data-mobile-menu
    class="mobile-menu-panel fixed inset-x-0 bottom-0 top-16 z-40 hidden border-t border-gray-800 px-6 py-6 font-sans text-base md:hidden"
  >
    <div class="mx-auto flex h-full max-w-7xl flex-col justify-between">
      <div class="flex flex-col gap-3">
        {
          navLinks.map((item) => (
            <a
              href={item.href}
              class="border-b border-gray-900 py-3 text-gray-300 hover:text-[#5B8DFF] transition-colors"
              data-mobile-menu-link
            >
              {item.label}
            </a>
          ))
        }
        <a
          href={localePath(alternateLocale)}
          class="border-b border-gray-900 py-3 text-gray-300 hover:text-[#5B8DFF] transition-colors"
          aria-label={ui.switchLanguage}
          hreflang={alternateLocale}
          lang={alternateLocale}
        >
          {alternateLabel}
        </a>
      </div>

      <div
        class="border-t border-gray-800 pt-5 text-sm text-gray-300"
      >
        <p class="mb-4 text-gray-500">{sections.contact.heading}</p>
        <div class="flex flex-wrap gap-4">
          <a
            href={`mailto:${contact.email}`}
            class="hover:text-[#5B8DFF] transition-colors"
            data-mobile-menu-link>{contact.emailLabel}</a
          >
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                class="hover:text-[#5B8DFF] transition-colors"
                data-mobile-menu-link
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </nav>

  <script>
    const menuButton = document.querySelector("[data-mobile-menu-button]");
    const mobileMenu = document.querySelector("[data-mobile-menu]");
    const iconOpen = document.querySelector("[data-menu-open]");
    const iconClose = document.querySelector("[data-menu-close]");

    const setMenuOpen = (isOpen) => {
      mobileMenu?.classList.toggle("hidden", !isOpen);
      menuButton?.setAttribute("aria-expanded", String(isOpen));
      menuButton?.setAttribute(
        "aria-label",
        isOpen
          ? menuButton.dataset.labelClose
          : menuButton.dataset.labelOpen,
      );
      document.body.style.overflow = isOpen ? "hidden" : "";
      iconOpen?.classList.toggle("hidden", isOpen);
      iconClose?.classList.toggle("hidden", !isOpen);
    };

    menuButton?.addEventListener("click", () => {
      setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
    });

    document.querySelectorAll("[data-mobile-menu-link]").forEach((link) => {
      link.addEventListener("click", () => setMenuOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMenuOpen(false);
      }
    });

    const revealElements = Array.from(
      document.querySelectorAll("[data-reveal]"),
    );
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      revealElements.forEach((element) => element.classList.add("is-visible"));
    } else {
      const revealObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { rootMargin: "0px 0px -12% 0px", threshold: 0.12 },
      );

      revealElements.forEach((element) => revealObserver.observe(element));
    }
  </script>

  <main
    id="main-content"
    class="relative z-10 max-w-5xl mx-auto px-6 pt-24 pb-0 space-y-32"
  >
    <section
      aria-labelledby="hero-title"
      class="relative pt-20 lg:pt-32 flex flex-col items-start min-h-[60vh] justify-center overflow-hidden"
    >
      <div class="relative z-10">
        <p
          class="font-sans text-sm tracking-widest uppercase text-[#5B8DFF] mb-4 reveal-static"
          data-reveal
          style="--reveal-delay: 120ms"
        >
          {hero.kicker}
        </p>
        <h1
          id="hero-title"
          class="max-w-full text-4xl sm:text-5xl md:text-6xl !font-sans !font-semibold text-white mb-6 tracking-tight leading-[1.05] reveal-static"
          data-reveal
          style="--reveal-delay: 220ms"
        >
          {hero.title}
          <br />
          <span
            class="text-[#5B8DFF]"
            >{hero.highlightedTitle}</span
          >
        </h1>
        <p
          class="text-lg md:text-xl text-gray-300 max-w-2xl font-sans mb-10 leading-relaxed reveal-static"
          data-reveal
          style="--reveal-delay: 340ms"
        >
          {hero.description}
        </p>
        <div
          class="flex flex-wrap gap-4 font-sans group reveal-static"
          data-reveal
          style="--reveal-delay: 460ms"
        >
          <a
            href={hero.primaryCta.href}
            class="relative px-6 py-3 bg-[#0B5CFF] text-white font-medium hover:bg-[#0B5CFF]/90 transition-all flex items-center gap-2"
          >
            {hero.primaryCta.label}
            <span
              aria-hidden="true"
              class="absolute inset-x-0 bottom-0 h-px bg-[#0B5CFF] origin-left scale-x-0 group-hover:scale-x-100 transition-transform"
            ></span>
          </a>
          <a
            href={hero.secondaryCta.href}
            class="px-6 py-3 text-gray-300 border border-gray-800 hover:border-gray-600 hover:text-gray-200 transition-colors"
          >
            {hero.secondaryCta.label}
          </a>
        </div>
      </div>
    </section>

    <section
      id="services"
      aria-labelledby="services-title"
      class="scroll-mt-32"
    >
      <div>
        <div
          class="flex items-center gap-4 mb-12 reveal-heading"
          data-reveal="left"
        >
          <h2
            id="services-title"
            class="text-3xl text-white"
          >
            {sections.services.heading}
          </h2>
          <div aria-hidden="true" class="h-px bg-gray-800 flex-1"></div>
        </div>
        <div class="service-grid grid md:grid-cols-2 gap-0">
          {
            services.map((service, i) => (
              <article
                class="service-grid-item p-8 lg:p-10 min-h-[18rem] transition-colors group reveal-lift hover:bg-[#161B22]/35"
                data-reveal
                style={`--reveal-delay: ${i * 90}ms`}
              >
                <div class="mb-8 flex h-12 w-12 items-center justify-start">
                  <MaterialIcon
                    name={service.icon}
                    class="text-4xl text-gray-200 group-hover:text-[#5B8DFF] transition-colors"
                    aria-hidden="true"
                  />
                </div>
                <h3 class="text-xl text-gray-200 mb-3 font-sans">
                  {service.title}
                </h3>
                <p class="text-sm text-gray-300 font-sans leading-relaxed">
                  {service.desc}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <Methodology data={Astro.props.data} />
    <Toolstack data={Astro.props.data} />

    {
      projects.length > 0 && (
    <section
      id="projects"
      aria-labelledby="projects-title"
      class="scroll-mt-32"
    >
      <div>
        <div
          class="flex items-center gap-4 mb-12 reveal-heading"
          data-reveal="left"
        >
          <h2
            id="projects-title"
            class="text-3xl text-white"
          >
            {sections.projects.heading}
          </h2>
          <div aria-hidden="true" class="h-px bg-gray-800 flex-1"></div>
        </div>
        <div class="space-y-8">
          {
            projects.map((project, i) => (
              <article
                class="border-l-2 border-gray-800 pl-6 py-2 hover:border-[#0B5CFF] transition-colors reveal-static"
                data-reveal="left"
                style={`--reveal-delay: ${i * 110}ms`}
              >
                <p class="text-xs text-[#5B8DFF] font-sans mb-2 uppercase tracking-widest">
                  {project.category}
                </p>
                <h3 class="text-2xl text-gray-200 font-sans mb-3">
                  {project.name}
                </h3>
                <p class="text-gray-300 font-sans mb-4 max-w-3xl">
                  {project.desc}
                </p>
                <div class="flex gap-3 font-sans text-xs text-gray-300">
                  {project.tech.map((t) => (
                    <span class="px-2 py-1 bg-gray-800/50 border border-gray-700/50 rounded">
                      {t}
                    </span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
      )
    }

    <section id="team" aria-labelledby="team-title" class="scroll-mt-32">
      <div
        class="flex items-center gap-4 mb-12 reveal-heading"
        data-reveal="left"
      >
        <h2 id="team-title" class="text-3xl text-white">
          {sections.team.heading}
        </h2>
        <div aria-hidden="true" class="h-px bg-gray-800 flex-1"></div>
      </div>
      <div class="grid gap-10 md:grid-cols-2">
        {
          team.map((person, i) => (
            <article
              class="flex gap-5 reveal-static"
              data-reveal="left"
              style={`--reveal-delay: ${i * 110}ms`}
            >
              {person.photo ? (
                <img
                  src={person.photo}
                  alt={person.name}
                  width="112"
                  height="112"
                  loading="lazy"
                  class="h-28 w-28 shrink-0 object-cover grayscale border border-gray-800"
                />
              ) : (
                <div
                  aria-hidden="true"
                  class="h-28 w-28 shrink-0 flex items-center justify-center border border-gray-800 bg-gray-900 font-sans text-2xl text-gray-500"
                >
                  {person.name
                    .split(" ")
                    .map((n) => n[0])
                    .join("")}
                </div>
              )}
              <div>
                <h3 class="text-xl text-gray-200 font-sans">{person.name}</h3>
                <p class="text-xs text-[#5B8DFF] font-sans mb-3 uppercase tracking-widest">
                  {person.role}
                </p>
                <p class="text-gray-300 font-sans text-sm leading-relaxed">
                  {person.bio}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section
      id="contact"
      aria-labelledby="contact-title"
      class="scroll-mt-32 pb-20"
    >
      <div class="max-w-2xl">
        <div
          class="flex items-center gap-4 mb-12 reveal-heading"
          data-reveal="left"
        >
          <h2
            id="contact-title"
            class="text-3xl text-white"
          >
            {sections.contact.heading}
          </h2>
          <div aria-hidden="true" class="h-px bg-gray-800 flex-1"></div>
        </div>
        <div
          class="p-8 border border-gray-800 bg-[#161B22]/50 rounded-sm relative reveal-static"
          data-reveal
        >

          <form
            action="https://api.web3forms.com/submit"
            method="post"
            class="space-y-6"
            aria-describedby="contact-help"
            data-contact-form
            data-sending={contact.statusSending}
            data-success={contact.statusSuccess}
            data-error={contact.statusError}
            data-captcha-required={contact.statusCaptcha}
            data-subject={ui.formSubject}
          >
            <input type="hidden" name="access_key" value={web3formsAccessKey} />
            <input type="hidden" name="subject" value={ui.formSubject} />
            <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
            <div>
              <label
                for="target-email"
                class="block font-sans text-xs text-gray-300 mb-2"
                >{contact.emailLabel}</label
              >
              <input
                id="target-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="w-full bg-[#0D1117] border border-gray-800 p-3 font-sans text-sm text-gray-200 focus:outline-none focus:border-[#0B5CFF]/50 transition-colors"
                placeholder={contact.emailPlaceholder}
              />
            </div>
            <div>
              <label
                for="payload"
                class="block font-sans text-xs text-gray-300 mb-2"
                >{contact.messageLabel}</label
              >
              <textarea
                id="payload"
                name="message"
                rows="4"
                required
                class="w-full bg-[#0D1117] border border-gray-800 p-3 font-sans text-sm text-gray-200 focus:outline-none focus:border-[#0B5CFF]/50 transition-colors resize-none"
                placeholder={contact.messagePlaceholder}></textarea>
            </div>
            <div class="h-captcha" data-captcha="true" data-theme="dark"></div>
            <p id="contact-help" class="text-xs text-gray-300">
              {contact.formHelp}
            </p>
            <p class="text-xs text-gray-400">
              {ui.privacyNotice}{" "}
              <a href="/datenschutz/" class="underline hover:text-white"
                >{ui.privacyLink}</a
              >.
            </p>
            <button
              type="submit"
              class="w-full py-3 bg-[#0B5CFF] text-white font-medium hover:bg-[#0B5CFF]/90 transition-colors text-sm"
              >{contact.submitLabel}</button
            >
            <p
              data-contact-status
              role="status"
              aria-live="polite"
              class="text-sm text-gray-300 font-sans"
            >
            </p>
          </form>
        </div>
      </div>
    </section>

  </main>
  <footer class="border-t border-gray-900 bg-[#0D1117] py-3 mt-auto">
      <div
        class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-4 text-xs font-sans text-gray-300"
      >
        <p>
          © {new Date().getFullYear()} {footer.status}
        </p>
        <div class="flex gap-4">
          <a
            href={`mailto:${contact.email}`}
            class="hover:text-white transition-colors">{contact.emailLabel}</a
          >
          <a href="/impressum/" class="hover:text-white transition-colors"
            >{ui.impressum}</a
          >
          <a href="/datenschutz/" class="hover:text-white transition-colors"
            >{ui.privacy}</a
          >
          {
            socialLinks.map((link) => (
              <a
                href={link.href}
                class="hover:text-[#5B8DFF] transition-colors"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
  </footer>
</div>

<script is:inline src="https://web3forms.com/client/script.js" async defer
></script>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-contact-form]");
    if (form) {
      const status = form.querySelector("[data-contact-status]");
      const button = form.querySelector("button[type=submit]");
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        const data = Object.fromEntries(new FormData(form));
        if (!data["h-captcha-response"]) {
          status.textContent = form.dataset.captchaRequired;
          return;
        }
        data.subject = form.dataset.subject;
        status.textContent = form.dataset.sending;
        button.disabled = true;
        try {
          const response = await fetch("https://api.web3forms.com/submit", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (!response.ok || !result.success) throw new Error(result.message);
          status.textContent = form.dataset.success;
          form.reset();
          if (window.hcaptcha) window.hcaptcha.reset();
        } catch (error) {
          status.textContent = form.dataset.error;
        } finally {
          button.disabled = false;
        }
      });
    }
  })();
</script>
