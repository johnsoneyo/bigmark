---
const { sections, toolCategories } = Astro.props.data;
const toolstack = sections.toolstack;
---

<section id="toolstack" aria-labelledby="toolstack-title" class="scroll-mt-32">
  <div class="flex items-center gap-4 mb-12 reveal-heading" data-reveal="left">
    <h2 id="toolstack-title" class="text-3xl text-white">
      {toolstack.heading}
    </h2>
    <div aria-hidden="true" class="h-px bg-gray-800 flex-1"></div>
  </div>

  <div class="grid gap-px border border-gray-800 bg-gray-800 md:grid-cols-2">
    {
      toolCategories.map((cat, i) => (
        <article
          class="group bg-[#0D1117] p-8 transition-colors hover:bg-[#10151D] reveal-static"
          data-reveal="left"
          style={`--reveal-delay: ${i * 90}ms`}
        >
          <p class="mb-6 font-mono text-xs tracking-widest text-[#5B8DFF]">
            {String(i + 1).padStart(2, "0")}
          </p>
          <h3 class="mb-2 text-xl text-gray-100 !font-sans !font-semibold">
            {cat.label}
          </h3>
          <p class="mb-6 text-sm text-gray-400 font-sans">{cat.desc}</p>
          <ul class="flex flex-wrap gap-2" aria-label={cat.label}>
            {cat.tools.map((tool) => (
              <li class="border border-gray-700/60 px-3 py-1 text-xs font-mono text-gray-300 transition-colors group-hover:border-[#0B5CFF]/40">
                {tool}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</section>
