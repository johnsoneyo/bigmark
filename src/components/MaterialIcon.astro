---
const { name, class: className = '', ...attrs } = Astro.props;

// Icons are drawn inline; no icon font is loaded.
const svgIcons: Record<string, string> = {
  cloud:
    '<path d="M7 18a4 4 0 0 1-.6-7.96A5.5 5.5 0 0 1 17 8.5a4.75 4.75 0 0 1 .5 9.5Z"/>',
  deployed_code:
    '<path d="M12 3 4 7.5v9L12 21l8-4.5v-9Z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>',
  settings_suggest:
    '<path d="M4 12a8 8 0 0 1 13.7-5.6L20 4v5.5h-5.5l2.2-2.2A6 6 0 0 0 6 12"/><path d="M20 12a8 8 0 0 1-13.7 5.6L4 20v-5.5h5.5l-2.2 2.2A6 6 0 0 0 18 12"/>',
  code: '<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 6l-3 12"/>',
  search: '<circle cx="11" cy="11" r="6"/><path d="m20 20-4.5-4.5"/>',
  architecture:
    '<path d="m12 3 9 4.5-9 4.5-9-4.5Z"/><path d="m3 12 9 4.5 9-4.5M3 16.5 12 21l9-4.5"/>',
  work_outline:
    '<rect x="3" y="7" width="18" height="13" rx="1.5"/><path d="M9 7V5h6v2M3 13h18"/>',
};
const svg = svgIcons[name];
---

{
  svg && (
    <svg
      class={`inline-block h-[1em] w-[1em] ${className}`}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.2"
      stroke-linecap="round"
      stroke-linejoin="round"
      set:html={svg}
      {...attrs}
    />
  )
}
